TYPE
  LOGLEVEL : (CRITICAL, WARNING, INFO, DEBUG) := INFO;
END_TYPE

FUNCTION_BLOCK LOGGER
  VAR_INPUT
    TRIG : BOOL;
    MSG : STRING;
    LEVEL : LOGLEVEL := INFO;
  END_VAR
  VAR
    TRIG0 : BOOL;
  END_VAR

  IF TRIG AND NOT TRIG0 THEN
  {{
   LogMessage(GetFbVar(LEVEL),(char*)GetFbVar(MSG, .body),GetFbVar(MSG, .len));
  }}
  END_IF;
  TRIG0:=TRIG;
END_FUNCTION_BLOCK


PROGRAM waterboiler
  VAR
    STOPPED_STATE : BOOL;
    RUN_STATE : BOOL;
    E_STATE : BOOL;
  END_VAR
  VAR
    START_BTN AT %IX0.0 : BOOL;
    STOP_BTN AT %IX0.1 : BOOL;
    E_STOP AT %IX0.2 : BOOL;
    TEMP_UP AT %IX0.3 : BOOL;
    TEMP_DWN AT %IX0.4 : BOOL;
    P_SWITCH AT %IX0.5 : BOOL;
    HEATER AT %QX0.0 : BOOL;
    LED0 AT %QX0.1 : BOOL;
    LED1 AT %QX0.2 : BOOL;
    LED2 AT %QX0.3 : BOOL;
    LED3 AT %QX0.4 : BOOL;
    LED4 AT %QX0.5 : BOOL;
    LED5 AT %QX0.6 : BOOL;
    E_LED AT %QX0.7 : BOOL;
    SETPOINT AT %MW0 : INT := 80;
    VOLT AT %IW0.0 : INT;
    ACTUAL_TEMPERATURE AT %MW1 : INT := 0;
    SERVO AT %QW0 : INT := 0;
  END_VAR
  VAR
    SR0 : SR;
    R_TRIG0 : R_TRIG;
    R_TRIG1 : R_TRIG;
  END_VAR
  VAR
    STATUS_RUN AT %MW2 : INT;
    STATUS_PWM AT %MW3 : INT;
  END_VAR
  VAR
    CTUD0 : CTUD;
    PWM_CONTROLLER0 : PWM_CONTROLLER;
  END_VAR
  VAR
    ANGLE AT %MW4 : INT := 0;
    POWER AT %MW6 : INT := 0;
    voltmulcurrent AT %MW7 : INT := 0;
    POWER1 AT %MW8 : WORD := 0;
    current_temp AT %MW9 : INT := 0;
    POWER_PERCENT AT %MW5 : INT := 0;
  END_VAR
  VAR
    PID0 : PID;
    CALCPOWER : REAL;
    R_TRIG2 : R_TRIG;
    R_TRIG3 : R_TRIG;
    _TMP_ADD92_OUT : INT;
    _TMP_MUL93_OUT : INT;
    _TMP_ADD94_OUT : INT;
    _TMP_EQ111_OUT : BOOL;
    _TMP_EQ22_OUT : BOOL;
    _TMP_EQ11_OUT : BOOL;
    _TMP_EQ23_OUT : BOOL;
    _TMP_EQ31_OUT : BOOL;
    _TMP_EQ33_OUT : BOOL;
    _TMP_EQ41_OUT : BOOL;
    _TMP_EQ42_OUT : BOOL;
    _TMP_EQ46_OUT : BOOL;
    _TMP_EQ50_OUT : BOOL;
    _TMP_EQ51_OUT : BOOL;
    _TMP_INT_TO_REAL76_OUT : REAL;
    _TMP_BOOL_TO_INT136_OUT : INT;
    _TMP_INT_TO_REAL135_OUT : REAL;
    _TMP_DIV120_OUT : REAL;
    _TMP_MUL121_OUT : REAL;
    _TMP_REAL_TO_INT133_OUT : INT;
    _TMP_MUL173_OUT : INT;
    _TMP_BOOL_TO_INT163_OUT : INT;
    _TMP_INT_TO_REAL182_OUT : REAL;
    _TMP_REAL_TO_INT180_OUT : INT;
    _TMP_MUL73_OUT : REAL;
    _TMP_DIV70_OUT : REAL;
    _TMP_DIV191_OUT : REAL;
    _TMP_MUL192_OUT : REAL;
    _TMP_REAL_TO_INT81_OUT : INT;
    _TMP_REAL_TO_INT71_OUT : INT;
    _TMP_REAL_TO_WORD72_OUT : WORD;
    _TMP_DIV198_OUT : REAL;
    _TMP_MUL199_OUT : REAL;
    _TMP_ADD202_OUT : REAL;
    _TMP_REAL_TO_INT88_OUT : INT;
  END_VAR

  RUN_STATE := (RUN_STATE OR START_BTN) AND NOT(STOP_BTN);
  STOPPED_STATE := NOT(E_STATE) AND NOT(RUN_STATE);
  HEATER := NOT(E_STATE) AND RUN_STATE;
  SR0(S1 := E_STOP AND RUN_STATE, R := STOP_BTN AND E_STOP AND E_STATE);
  E_STATE := SR0.Q1;
  E_LED := E_STATE;
  R_TRIG0(CLK := TEMP_UP AND NOT(E_STATE) AND NOT(RUN_STATE));
  R_TRIG2(CLK := R_TRIG0.Q);
  R_TRIG1(CLK := TEMP_DWN AND NOT(E_STATE) AND NOT(RUN_STATE));
  R_TRIG3(CLK := R_TRIG1.Q);
  CTUD0(CU := R_TRIG2.Q, CD := R_TRIG3.Q, PV := 10);
  _TMP_ADD92_OUT := ADD(CTUD0.CV, 1);
  _TMP_MUL93_OUT := MUL(_TMP_ADD92_OUT, 10);
  _TMP_ADD94_OUT := ADD(_TMP_MUL93_OUT, 70);
  SETPOINT := _TMP_ADD94_OUT;
  _TMP_EQ111_OUT := EQ(80, SETPOINT);
  _TMP_EQ22_OUT := EQ(SETPOINT, 90);
  LED0 := _TMP_EQ111_OUT OR _TMP_EQ22_OUT;
  _TMP_EQ11_OUT := EQ(SETPOINT, 100);
  _TMP_EQ23_OUT := EQ(SETPOINT, 110);
  LED1 := _TMP_EQ11_OUT OR _TMP_EQ22_OUT OR _TMP_EQ23_OUT;
  _TMP_EQ31_OUT := EQ(SETPOINT, 120);
  _TMP_EQ33_OUT := EQ(SETPOINT, 130);
  LED2 := _TMP_EQ23_OUT OR _TMP_EQ31_OUT OR _TMP_EQ33_OUT;
  _TMP_EQ41_OUT := EQ(SETPOINT, 140);
  _TMP_EQ42_OUT := EQ(SETPOINT, 150);
  LED3 := _TMP_EQ33_OUT OR _TMP_EQ41_OUT OR _TMP_EQ42_OUT;
  _TMP_EQ46_OUT := EQ(SETPOINT, 160);
  _TMP_EQ50_OUT := EQ(SETPOINT, 170);
  LED4 := _TMP_EQ42_OUT OR _TMP_EQ46_OUT OR _TMP_EQ50_OUT;
  _TMP_EQ51_OUT := EQ(SETPOINT, 180);
  LED5 := _TMP_EQ50_OUT OR _TMP_EQ51_OUT;
  IF E_STATE THEN
    LED0 := FALSE; (*reset*)
  END_IF;
  IF E_STATE THEN
    LED1 := FALSE; (*reset*)
  END_IF;
  IF E_STATE THEN
    LED2 := FALSE; (*reset*)
  END_IF;
  IF E_STATE THEN
    LED3 := FALSE; (*reset*)
  END_IF;
  IF E_STATE THEN
    LED4 := FALSE; (*reset*)
  END_IF;
  IF E_STATE THEN
    LED5 := FALSE; (*reset*)
  END_IF;
  _TMP_INT_TO_REAL76_OUT := INT_TO_REAL(ANGLE);
  PWM_CONTROLLER0(CHANNEL := 1, FREQ := 50.00, DUTY := _TMP_INT_TO_REAL76_OUT);
  _TMP_BOOL_TO_INT136_OUT := BOOL_TO_INT(PWM_CONTROLLER0.SUCCESS);
  STATUS_PWM := _TMP_BOOL_TO_INT136_OUT;
  _TMP_INT_TO_REAL135_OUT := INT_TO_REAL(VOLT);
  _TMP_DIV120_OUT := DIV(_TMP_INT_TO_REAL135_OUT, 65535.0);
  _TMP_MUL121_OUT := MUL(_TMP_DIV120_OUT, 190.0);
  _TMP_REAL_TO_INT133_OUT := REAL_TO_INT(_TMP_MUL121_OUT);
  _TMP_MUL173_OUT := MUL(_TMP_REAL_TO_INT133_OUT, 10);
  ANGLE := _TMP_MUL173_OUT;
  _TMP_BOOL_TO_INT163_OUT := BOOL_TO_INT(RUN_STATE AND NOT(STOP_BTN) AND START_BTN AND NOT(STOP_BTN));
  STATUS_RUN := _TMP_BOOL_TO_INT163_OUT;
  _TMP_INT_TO_REAL182_OUT := INT_TO_REAL(SETPOINT);
  PID0(AUTO := TRUE, PV := CALCPOWER, SP := _TMP_INT_TO_REAL182_OUT, CYCLE := T#100ms);
  _TMP_REAL_TO_INT180_OUT := REAL_TO_INT(PID0.XOUT);
  POWER := _TMP_REAL_TO_INT180_OUT;
  _TMP_MUL73_OUT := MUL(_TMP_INT_TO_REAL135_OUT, 3.3);
  _TMP_DIV70_OUT := DIV(_TMP_MUL73_OUT, 65536.0);
  CALCPOWER := _TMP_DIV70_OUT;
  CALCPOWER := PID0.XOUT;
  _TMP_DIV191_OUT := DIV(CALCPOWER, 3.3);
  _TMP_MUL192_OUT := MUL(_TMP_DIV191_OUT, 100.0);
  _TMP_REAL_TO_INT81_OUT := REAL_TO_INT(_TMP_MUL192_OUT);
  POWER_PERCENT := _TMP_REAL_TO_INT81_OUT;
  ACTUAL_TEMPERATURE := VOLT;
  _TMP_REAL_TO_INT71_OUT := REAL_TO_INT(_TMP_MUL73_OUT);
  voltmulcurrent := _TMP_REAL_TO_INT71_OUT;
  _TMP_REAL_TO_WORD72_OUT := REAL_TO_WORD(_TMP_DIV70_OUT);
  POWER1 := _TMP_REAL_TO_WORD72_OUT;
  _TMP_DIV198_OUT := DIV(CALCPOWER, 3.3);
  _TMP_MUL199_OUT := MUL(_TMP_DIV198_OUT, -110.0);
  _TMP_ADD202_OUT := ADD(_TMP_MUL199_OUT, 80.0);
  _TMP_REAL_TO_INT88_OUT := REAL_TO_INT(_TMP_ADD202_OUT);
  current_temp := _TMP_REAL_TO_INT88_OUT;
END_PROGRAM


CONFIGURATION Config0

  RESOURCE Res0 ON PLC
    TASK task0(INTERVAL := T#20ms,PRIORITY := 0);
    PROGRAM instance0 WITH task0 : waterboiler;
  END_RESOURCE
END_CONFIGURATION
